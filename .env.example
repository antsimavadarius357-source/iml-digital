# Copier vers backend/.env puis renseigner les valeurs. Ne jamais committer ce fichier.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL hébergé par Supabase (Project Settings > Database > Connection string) ---
# DATABASE_URL : connexion "Transaction pooler" (port 6543) utilisée par l'application
DATABASE_URL="postgresql://postgres.REF_PROJET:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL : connexion directe/session pooler (port 5432) utilisée uniquement par les migrations Prisma
DIRECT_URL="postgresql://postgres.REF_PROJET:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=GENERER_UNE_VALEUR_ALEATOIRE_DE_32_CARACTERES_MINIMUM
STORAGE_DIR=./storage
